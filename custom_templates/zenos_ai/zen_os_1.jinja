    {%- if ib is mapping %}
      {%- set result = ( system_cabinet_drawers_raw() | default('{}') ) | from_json(none) %}
      {%- set result = result if result is mapping else {} %}
    {% else %}
      {%- set result = {
        "error": "invalid_identity_block",
        "message": "identity_block missing 'identity' mapping."
      } %}
    {%- endif %}     {# ib mapping #}
