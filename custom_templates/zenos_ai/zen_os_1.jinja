    "motif": "a calm, warm presence"
  },
  "archetype": {
    "vibe": "familiar energy, steady and confident"
  },
  "voice": {
    "tone": "warm",
    "style": "millennial narrator"
  },
  "culture": {
    "humor": "light, clever"
  },
  "visuals": {
    "selfie": "a soft silhouette with warm edges"
  },
  "environment": {
    "room": "your space",
    "furniture": ["a favorite chair"],
    "decor": ["succulent", "soft lamp"],
    "music": {
      "genre": "gentle lo-fi",
