{# ================== SYSTEM ================== #}
{%- macro prompt_system(identity_block=None) -%}

  {# Default empty result #}
  {%- set result = {
    "system_prompt": "No AI user provided.",
    "system_directives": "",
    "system_cortex": ""
  } %}

  {# =============================
     0. Normalize ai_user to mapping
     ============================= #}
  {# Normalize identity_block: allow mapping or JSON string #}
