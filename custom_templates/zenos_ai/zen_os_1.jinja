{# ================== MANIFEST LOADER ================== #}
{%- macro manifest_loader() -%}
  {%- set mani_cab = states('sensor.zen_default_household_cabinet_resolved') -%}
  {%- set ns = namespace(cabs={}) -%}
  {%- if mani_cab not in ['', 'unknown', 'unavailable'] -%}
    {%- set manifest_raw = CABS.cabinet_drawer_value(mani_cab, 'zen_library_manifest') | from_json(none) -%}
    {%- set manifest_raw = manifest_raw if manifest_raw is mapping else {} -%}
    {%- if manifest_raw is mapping -%}
      {%- for eid, cab in manifest_raw.items() -%}
        {%- if cab is mapping and cab.get('status') == 'ready' -%}
          {%- set _entry = {'name': cab.get('friendly_name', ''), 'drawers': cab.get('drawers', 0)} -%}
          {%- set ns.cabs = ns.cabs | combine({eid: _entry}) -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
  {{ ns.cabs | tojson }}
{%- endmacro -%}

{# ================== IDENTITY MANIFEST LOADER ================== #}
{#
  identity_manifest_loader() — reads zen_identity_manifest from the
  Default Household Cabinet. Pre-built by identity dojotools
  (mode: build_identity_manifest). Same pattern as manifest_loader().

  Returns one of:
    {status: 'ok',        roster: {...}, tree: {...}}   — current shape (v4.3+)
    {status: 'ok_legacy', roster: {...}, tree: {}}      — pre-tree flat format (back-compat)
    {status: 'not_built', roster: {},   tree: {}}       — drawer absent or unparseable
#}
{%- macro identity_manifest_loader() -%}
  {%- set hh_cab = states('sensor.zen_default_household_cabinet_resolved') -%}
  {%- if hh_cab not in ['', 'unknown', 'unavailable'] -%}
    {%- set mani = CABS.cabinet_drawer_value(hh_cab, 'zen_identity_manifest') | from_json() -%}
    {%- set mani = mani if mani is mapping else {} -%}
    {%- set raw_roster = mani.get('roster', {}) -%}
    {%- set roster_list = raw_roster.get('roster', raw_roster) if raw_roster is mapping else [] -%}
    {%- set roster_list = roster_list if roster_list is sequence and roster_list is not string and roster_list is not mapping else [] -%}
    {%- set ns = namespace(members=[]) -%}
    {%- for member in roster_list -%}
      {%- if member is mapping -%}
        {%- set ns.members = ns.members + [{'name': member.get('name',''), 'type': member.get('type',''), 'entity_id': member.get('entity_id','')}] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if 'roster' not in mani -%}
      {{ {'status': 'not_built'} | tojson }}
    {%- else -%}
      {{ {'members': ns.members} | tojson }}
    {%- endif -%}
  {%- else -%}
    {{ {'status': 'not_built'} | tojson }}
  {%- endif -%}
{%- endmacro -%}

{# ================== ROOT INDEX ================== #}
{#
  root_index() — compact label navigation index for the AI prompt.
  Reads _compact_index from the Default Household Cabinet.
  Returns compact manifest (dict) when fresh, falls back to raw labels list
  (dict with mode:'fallback') when stale or uninitialized.
  Read-only — cannot trigger a rebuild from Jinja. Run zen_dojotools_index
  mode: build_compact_index to populate/refresh.
#}
{%- macro root_index() -%}
  {%- set hcab = states('sensor.zen_default_household_cabinet_resolved') -%}
  {#-
  {%- set ci_entry = {} -%}
  {%- if hcab -%}
    {%- set hc_vars = state_attr(hcab, 'variables') or {} -%}
    {%- set ci_raw = hc_vars.get('_compact_index') -%}
    {%- set ci_entry = ci_raw if ci_raw is mapping else {} -%}
  {%- endif -%}
  {%- set ci_val = ci_entry.get('value') -%}
  {%- set ci_val = ci_val if ci_val is mapping else {} -%}
  -#}
  {%- set ci_val = CABS.cabinet_drawer_value(hcab, '_compact_index') | from_json() -%}
  {%- set ci_val = ci_val if ci_val is mapping else {} -%}

  {%- set ci_generated = ci_val.get('generated', '') -%}
  {%- set ci_labels = ci_val.get('labels', []) -%}
  {%- if ci_generated | length > 0 -%}
    {%- set ci_age_s = (now() - as_datetime(ci_generated)).total_seconds() -%}
  {%- else -%}
    {%- set ci_age_s = 9999 -%}
  {%- endif -%}
  {%- set ci_stale = ci_age_s > 3600 -%}
  {%- set _excl_raw = CABS.cabinet_drawer(hcab, 'compact_index_exclude', []) | from_json() -%}
  {%- set _excl_val = _excl_raw.get('value', _excl_raw) if _excl_raw is mapping else _excl_raw -%}
  {%- set ci_exclude = _excl_val if _excl_val is sequence and _excl_val is not string and _excl_val is not mapping else [] -%}
  {%- if ci_labels | length > 0 -%}
    {%- set ns = namespace(filtered=[]) -%}
    {%- for entry in ci_labels -%}
      {%- if entry.get('label', '') not in ci_exclude -%}
        {%- set ns.filtered = ns.filtered + [{'label': entry.get('label',''), 'group': entry.get('group','')}] -%}
      {%- endif -%}
    {%- endfor -%}
    {{ {'labels': ns.filtered, 'stale': ci_stale} | tojson }}
  {%- else -%}
    {{ {
      'mode': 'fallback',
      'note': 'Compact index not initialized. Run zen_dojotools_index mode: build_compact_index.',
      'labels': labels() | list | sort
    } | tojson }}
  {%- endif -%}
{%- endmacro -%}

{# ================== INDEX LOADER ================== #}
{# Shim — retained for backward compatibility. Prefer root_index(). #}
{%- macro index_loader() -%}
  {{ root_index() }}
{%- endmacro -%}

{# ================== DOJO META ================== #}
{%- macro dojo_kungfu_meta(dojo) -%}
  {%- if dojo is mapping and 'kung_fu' in dojo and dojo['kung_fu'] is mapping -%}
    {%- set kf_raw = dojo['kung_fu'] -%}
    {%- set kf = kf_raw.get('value', kf_raw) if kf_raw is mapping else {} -%}
    {%- set meta = dict(
      version = kf.get('version', 'unknown'),
      branch = kf.get('branch', 'unknown')
    ) %}
  {%- else -%}
    {%- set meta = dict(version = "unknown", branch = "unknown") %}
  {%- endif -%}
  {{ meta | tojson }}
{%- endmacro -%}

{# ================== DRAWER BUILDER ================== #}
{%- macro zen_drawer(drawer, value, kata_cab, desc="") -%}
  {%- set _enabled = ((value['meta'] | default({})) if value is mapping else {}).get('enabled', true) | bool -%}
  {%- set kata_val = CABS.cabinet_drawer_value(kata_cab, drawer) | from_json() -%}
  {%- set kata_val = kata_val if kata_val is mapping else {} -%}
  {%- set _urgency   = kata_val.get('urgency', 1) -%}
  {%- set _attention = kata_val.get('attention', none) -%}
  {%- set kata_signal = {'urgency': _urgency} -%}
  {%- if _attention is not none -%}
    {%- set kata_signal = kata_signal | combine({'attention': _attention}) -%}
  {%- endif -%}
  {{
    {
      'id':          drawer,
      'friendly_name': value['friendly_name'] | default(''),
      'label':       value['label'] | default(''),
      'description': desc,
      'meta':        {'enabled': _enabled},
      'kata':        kata_signal
    } | tojson
  }}
{%- endmacro -%}

{# ================== MAIN DOJO LOADER ================== #}
{%- macro dojo_loader() -%}
  {%- set dojo_cab = states('sensor.zen_dojo_cabinet_resolved') -%}
  {%- set kata_cab = states('sensor.zen_kata_cabinet_resolved') -%}
  {%- set dojo = state_attr(dojo_cab, 'variables') or {} -%}
  {%- set meta = (dojo_kungfu_meta(dojo) | default('{}')) | from_json(none) -%}
  {%- set meta = meta if meta is mapping else {} -%}
  {%- set zen_summary = CABS.cabinet_drawer_value(kata_cab, 'zen_summary') | from_json() -%}
  {%- set data = namespace(components=[]) -%}

  {%- for drawer, node in dojo.items() -%}
    {%- if drawer == 'kung_fu' -%}{%- continue -%}{%- endif -%}
    {%- if node is mapping and 'value' in node and node['value'] is mapping -%}
      {%- set value = node['value'] -%}
    {%- elif node is mapping and 'value' in node and node['value'] is string -%}
      {%- set value = node['value'] | from_json(none) -%}
      {%- set value = value if value is mapping else {} -%}
    {%- elif node is mapping -%}
      {%- set value = node -%}
    {%- else -%}
      {%- set value = none -%}
    {%- endif -%}
    {%- if value is mapping -%}
      {%- set _lbl  = value.get('label', '') -%}
      {%- set _desc = (label_description(_lbl) | default('', true)) if _lbl else '' -%}
      {%- set _desc = _desc if _desc else value.get('component_summary', '') -%}
      {%- set component = zen_drawer(drawer, value, kata_cab, _desc) | from_json(none) -%}
      {%- set component = component if component is mapping else {} -%}
      {%- set data.components = data.components + [component] -%}
    {%- endif -%}
  {%- endfor -%}

  {%- set meta_slim = {'version': meta.get('version','unknown'), 'branch': meta.get('branch','unknown')} -%}
  {{
    {
      'kung_fu':     meta_slim,
      'drawers':     data.components,
      'zen_summary': zen_summary
    } | tojson
  }}
{%- endmacro -%}

{# ===========================================
