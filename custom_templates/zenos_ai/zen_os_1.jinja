        'system':         _system   | length,
        'manifest':       _mfst     | length,
        'id_manifest':    _id_mani  | length,
        'index':          _idx      | length,
        'dojo':           _dojo     | length,
        'capsule':        _cap      | length,
        'overview':       _over     | length,
        'wake':           _wake     | length,
        'priority_inject': _pri     | length,
