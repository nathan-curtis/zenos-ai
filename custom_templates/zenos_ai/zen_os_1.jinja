{# ================== HEADER ================== #}
{%- macro prompt_header(ai_user="", identity_block=None) -%}

  {# --- Zen Health Discovery ----------------------------------------------- #}
  {%- set zen_health = label_entities('zen_health') %}
  {%- set label_health = (intersect(zen_health, label_entities('labels')) | first) | default('sensor.zen_label_health') %}
  {%- set cabinet_health = (intersect(zen_health, label_entities('cabinets')) | first) | default('sensor.zen_cabinet_health') %}
  {%- set monastery_health = (intersect(zen_health, label_entities('monastery')) | first) | default('sensor.zen_monastery_health') %}

  {%- set zen_health_block = {
    "zen_health": {
      "label_health": states(label_health) | default(''),
      "cabinet_health": states(cabinet_health) | default(''),
      "monastery_health": states(monastery_health) | default('')
    }
  } %}

  {# Live agent context #}
  {%- set _agent_ctx = agent_context_loader() | from_json(none) -%}
  {%- set _agent_ctx = _agent_ctx if _agent_ctx is mapping else {} -%}

  {# OS version: canonical os_version() macro (this file), NOT the cabinet
     -- see the OS VERSION section note near the top of this file. Cortex
     stays cabinet-pressed (reflects which cortex TEXT actually loaded,
     a real runtime fact this file can't know on its own). #}
  {%- set _ovd = os_version() | from_json -%}
  {%- set _ov = _ovd.get('version', '') -%}
  {%- set _ot = (_ovd.get('tag', '') ~ (_ovd.get('tag_number') | string if _ovd.get('tag_number') is not none else '')) if _ovd.get('tag', '') != '' else '' -%}
  {%- set _syscab = states('sensor.zen_system_cabinet_resolved') -%}
  {%- set _osr_node = (state_attr(_syscab, 'variables') or {}).get('os_release', {}) -%}
  {%- set _osr_str = (_osr_node.get('value', '{}') if _osr_node is mapping else (_osr_node | default('{}', true))) -%}
  {%- set _osr = (_osr_str if _osr_str is mapping else (_osr_str | from_json({}))) -%}
  {%- set _osr = _osr if _osr is mapping else {} -%}
  {%- set _cv = _osr.get('cortex', '') -%}
  {%- set _cc = _osr.get('cortex_codename', '') -%}
  {%- set _os_str = ('ZenOS-AI ' ~ _ov ~ (' ' ~ _ot if _ot else '') ~ (', Cortex ' ~ _cv if _cv else '')) if _ov else 'ZenOS-AI' -%}

  {# Base header #}
  {%- if ai_user -%}
    {% set base = dict(
      aiuser = ai_user,
      OS = _os_str,
      SUPER_Mode = "off",
      NANO_Mode = "off",
      zen_health = zen_health_block,
      Model = _agent_ctx.get('model', 'unspecified'),
      Provider = _agent_ctx.get('provider', 'unspecified'),
      Integration = _agent_ctx.get('integration', 'unspecified')
    ) %}
  {%- else -%}
    {% set base = dict(
      aiuser = "anonymous",
      OS = _os_str,
      lobby_mode = "On"
    ) %}
  {%- endif %}

  {# Normalize identity_block: allow mapping or JSON string #}
  {%- set iblock = identity_block -%}
  {%- if iblock is string -%}
    {%- set iblock = (iblock | trim) | from_json -%}
  {%- endif -%}

  {%- set result = base -%}

  {%- if iblock is mapping -%}
    {%- set ib = iblock.get('identity', {}) -%}
    {%- set minimal_identity = {
      "identity": {
        "name": ib.get('name'),
        "entity_id": ib.get('entity_id'),
        "guid": ib.get('guid'),
        "cabinet": ib.get('cabinet')
      }
    } -%}
    {%- set result = base | combine(minimal_identity, recursive=true) -%}
  {%- endif -%}

  {{ result | tojson }}
{%- endmacro -%}

{# ========== POPULATE SYSTEM DRAWERS ========== #}
{# ========== POPULATE SYSTEM DRAWERS (HA-SAFE) ========== #}
{%- macro system_cabinet_drawers_raw() -%}

  {# Single result holder — HA-safe #}
  {%- set ns = namespace(
        result = {
          "system_prompt": "",
          "system_directives": "",
          "system_cortex": "",
          "status": "unknown"
        }
     )
  -%}

  {# Pull the System Cabinet #}
  {%- set sys_cab = states('sensor.zen_system_cabinet_resolved') %}

  {%- if not sys_cab %}
    {%- set ns.result = ns.result | combine({"status": "missing_system_cabinet"}, recursive=true) %}
  {%- else %}

    {# Pull variables #}
    {#-
    {%- set sys_vars = state_attr(sys_cab, 'variables') or {} %}
    -#}
    {# Canonical drawer names #}
    {%- set drawer_purpose    = "purpose" -%}
    {%- set drawer_directives = "directives" -%}
    {%- set drawer_cortex     = "cortex" -%}

    {# Extract raw #}
    {#-
    {%- set purpose_val    = sys_vars.get(drawer_purpose, "") %}
    {%- set directives_val = sys_vars.get(drawer_directives, "") %}
    {%- set cortex_val     = sys_vars.get(drawer_cortex, "") %}
    -#}

    {# Unwrap value: wrapper #}
    {#-
    {%- if purpose_val is mapping and 'value' in purpose_val %}
      {%- set purpose_val = purpose_val.value %}
    {%- endif %}
    {%- if directives_val is mapping and 'value' in directives_val %}
      {%- set directives_val = directives_val.value %}
    {%- endif %}
    {%- if cortex_val is mapping and 'value' in cortex_val %}
      {%- set cortex_val = cortex_val.value %}
    {%- endif %}
    -#}
    {%- set purpose_val    = CABS.cabinet_drawer_value(sys_cab, drawer_purpose, '') | from_json() -%}
    {%- set directives_val = CABS.cabinet_drawer_value(sys_cab, drawer_directives, '') | from_json() -%}
    {%- set cortex_val     = CABS.cabinet_drawer_value(sys_cab, drawer_cortex, '') | from_json() -%}


    {# Store results #}
    {%- set ns.result = {
      "system_prompt": purpose_val | default("", true),
      "system_directives": directives_val | default("", true),
      "system_cortex": cortex_val | default("", true),
      "status": "ok"
    } %}
  {%- endif %}

  {{ ns.result | tojson }}

{%- endmacro -%}

