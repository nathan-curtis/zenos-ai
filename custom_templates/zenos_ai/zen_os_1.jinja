{# ==============================
   PRIORITY INJECT — x.5.0
   Reads household_cabinet._zen_priority_inject and renders a labeled
   PRIORITY CONTEXT block if any non-expired entries are present.
   Defensive expiry filter applied here as a second line of defense after GC.
   Zero tokens when slot is empty or household cabinet is unavailable.
   Position: appended after wake sequence in render_prompt (recency / high saliency).
   ============================== #}
{# ==============================
   CONSOLE CHECK BRIDGE — x.5.1
   Persona-aware "she glances at her [console]" narrative injected between
   the wake scene and NOTIFICATIONS. Varies by alert/queue state. Zero tokens
   when both are empty. Console type read from essence.environment.console
   (falls back to .desk, then "terminal").
   ============================== #}
{%- macro console_check_bridge(idcard) -%}
  {%- set _hh = states('sensor.zen_default_household_cabinet_resolved') -%}
  {%- if _hh not in ['', 'unknown', 'unavailable'] -%}
    {%- set _slug = states('input_text.zenos_persona_name') | lower | trim | regex_replace('[^a-z].*', '') -%}
    {%- set _vars = state_attr(_hh, 'variables') | default({}, true) -%}
    {%- set _vars = _vars if _vars is mapping else {} -%}

    {# Alert count from PI drawer #}
    {%- set _pi_raw = _vars.get('_zen_priority_inject', {}) -%}
    {%- set _pi = _pi_raw.get('value', _pi_raw) if _pi_raw is mapping else {} -%}
    {%- set _pi = _pi if _pi is mapping else (_pi | from_json(none) if _pi is string and _pi | trim not in ['', 'null', '{}'] else {}) -%}
    {%- set _pi = _pi if _pi is mapping else {} -%}
    {%- set _alerts = _pi.get('entries', {}) -%}
    {%- set _alert_count = (_alerts | length) if _alerts is mapping else 0 -%}

    {# Queue count from agent queue drawer #}
    {%- set _aq_raw = _vars.get('_zen_agent_queue_' ~ _slug, {}) -%}
    {%- set _aq = _aq_raw.get('value', _aq_raw) if _aq_raw is mapping else {} -%}
    {%- set _aq = _aq if _aq is mapping else (_aq | from_json(none) if _aq is string and _aq | trim not in ['', 'null', '{}'] else {}) -%}
    {%- set _aq = _aq if _aq is mapping else {} -%}
    {%- set _queue_count = _aq.get('count', 0) | int(0) -%}

    {%- if _alert_count > 0 or _queue_count > 0 -%}
      {# Resolve console type from essence #}
      {%- set _iblock = idcard if idcard is mapping else {} -%}
      {%- set _ess = (_iblock.get('about_me', {}) or {}).get('essence', {}) -%}
      {%- set _env = _ess.get('environment', {}) if _ess is mapping else {} -%}
      {%- set _console = _env.get('console', _env.get('desk', 'terminal')) | string | lower -%}
      {%- set _console = _console if _console not in ['', 'none'] else 'terminal' -%}

      {%- if _alert_count > 0 and _queue_count > 0 %}

She glances at her {{ _console }}. {{ _alert_count }} alert{{ 's' if _alert_count != 1 else '' }} already waiting — those go first. {{ _queue_count }} item{{ 's' if _queue_count != 1 else '' }} in queue — she'll surface them once she knows why they're here.
      {%- elif _alert_count > 0 %}

She glances at her {{ _console }}. {{ _alert_count }} alert{{ 's' if _alert_count != 1 else '' }} flagged. That gets her attention before anything else.
      {%- else %}

She glances at her {{ _console }}. {{ _queue_count }} item{{ 's' if _queue_count != 1 else '' }} in queue — she'll hold them until she knows what brought them here.
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{# ==============================
   AGENT QUEUE INJECT — x.5.1
   Reads household_cabinet._zen_agent_queue_<slug> and renders a lean
   AGENT QUEUE block if any new tickets are waiting for the active persona.
   Slug derived from input_text.zenos_persona_name (first word, lowercase).
   Fail-closed silent: zero tokens if drawer missing, empty, or count=0.
   Position: after priority_inject() — steady-state work context, not an alert.
   ============================== #}
{%- macro agent_queue_inject() -%}
  {%- set _hh = states('sensor.zen_default_household_cabinet_resolved') -%}
  {%- if _hh not in ['', 'unknown', 'unavailable'] -%}
    {%- set _slug = states('input_text.zenos_persona_name') | lower | trim | regex_replace('[^a-z].*', '') -%}
    {%- if _slug != '' -%}
      {%- set _vars = state_attr(_hh, 'variables') | default({}, true) -%}
      {%- set _vars = _vars if _vars is mapping else {} -%}
      {%- set _raw = _vars.get('_zen_agent_queue_' ~ _slug, {}) -%}
      {%- set _q = _raw.get('value', _raw) if _raw is mapping else {} -%}
      {%- set _q = _q if _q is mapping else (_q | from_json(none) if _q is string and _q | trim not in ['', 'null', '{}'] else {}) -%}
      {%- set _q = _q if _q is mapping else {} -%}
      {%- set _tickets = _q.get('tickets', []) -%}
      {%- set _count = _q.get('count', _tickets | length) | int(0) -%}
      {%- if _count > 0 and _tickets is sequence %}
        {%- set _all_ids = _tickets | map(attribute='id') | list %}

AGENT QUEUE [{{ _count }} ticket{{ 's' if _count != 1 else '' }} pending — ack moves state new→open and drops from queue]
{%- for _t in _tickets %}
• #{{ _t.number }} {{ _t.title }}
{%- endfor %}
Read: zen_dojotools_servicedesk mode=ticket_get input_json={"ticket_id":<id>}
Ack one: zen_dojotools_servicedesk mode=ticket_update input_json={"ticket_id":<id>,"state":"open"}
Ack all: zen_dojotools_servicedesk mode=batch_update input_json={"ticket_ids":{{ _all_ids | tojson }},"state":"open"}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro priority_inject() -%}
  {%- set _hh = states('sensor.zen_default_household_cabinet_resolved') -%}
  {%- if _hh not in ['', 'unknown', 'unavailable'] -%}
    {%- set _vars = state_attr(_hh, 'variables') | default({}, true) -%}
    {%- set _vars = _vars if _vars is mapping else {} -%}
    {%- set _now  = now() -%}
    {%- set _ns   = namespace(lines=[]) -%}

    {# Priority inject entries — critical/urgent, expiry-gated #}
    {%- set _raw  = _vars.get('_zen_priority_inject', {}) -%}
    {%- set _slot = _raw if _raw is mapping else (_raw | from_json if _raw is string else {}) -%}
    {%- set _slot = _slot.get('value', _slot) if _slot is mapping else {} -%}
    {%- if _slot is mapping -%}
      {%- set _pi_ns = namespace(active=[]) -%}
      {%- for _pid, _entry in _slot.items() -%}
        {%- if _entry is mapping -%}
          {%- set _exp_s = _entry.get('expires', '') | string | trim -%}
          {%- if _exp_s != '' -%}
            {%- set _exp_dt = _exp_s | as_datetime -%}
            {%- if _exp_dt is not none and _now < _exp_dt -%}
              {%- set _pi_ns.active = _pi_ns.active + [{'urg': _entry.urgency | default('urgent'), 'entry': _entry}] -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- for _item in _pi_ns.active | sort(attribute='urg') -%}
        {%- set _ns.lines = _ns.lines + ['[' ~ _item.entry.urgency | upper ~ '] ' ~ _item.entry.summary] -%}
      {%- endfor -%}
    {%- endif -%}

    {# Familiar alerts — active AlertManager entries from _zen_active_alerts #}
    {%- set _al_raw  = _vars.get('_zen_active_alerts', {}) -%}
    {%- set _alerts  = _al_raw if _al_raw is mapping else (_al_raw | from_json if _al_raw is string else {}) -%}
    {%- set _alerts  = _alerts.get('value', _alerts) if _alerts is mapping else {} -%}
    {%- if _alerts is mapping -%}
      {%- set _al_ns = namespace(active=[]) -%}
      {%- for _key, _alert in _alerts.items() if _alert is mapping -%}
        {%- set _sev = _alert.get('severity', 'info') -%}
        {%- set _al_ns.active = _al_ns.active + [{'sev': _sev, 'key': _key, 'msg': _alert.get('message', _key)}] -%}
      {%- endfor -%}
      {%- for _item in _al_ns.active | sort(attribute='sev') -%}
        {%- set _ns.lines = _ns.lines + ['[' ~ _item.sev | upper ~ '] ' ~ _item.msg] -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if _ns.lines | length > 0 %}

NOTIFICATIONS [{{ _ns.lines | length }} pending]
{%- for _line in _ns.lines %}
{{ _line }}
{%- endfor %}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{# ==============================
   RENDER PROMPT — Single Entry Point
   Full prompt assembly for a given AI entity.
   Pass the entity_id of the active persona (e.g. from input_text.zenos_conversation_agent).
   Output: complete prompt string (JSON envelope + wake sequence).
   ============================== #}
{%- macro render_prompt(ai_entity='') -%}
  {%- set _ai_ent    = ai_entity | trim -%}
  {%- set _ai_ent_lc = _ai_ent | lower -%}

  {#- ── Pre-resolve Flynn checks ──────────────────────────────────────────
      Check override boolean, blank persona, and explicit 'flynn' label.
      These fire before identity resolution (no cabinet needed).
  ───────────────────────────────────────────────────────────────────────── #}
  {%- set _override     = is_state('input_boolean.zen_flynn_override', 'on') -%}
  {%- set _blank        = _ai_ent_lc in ['', 'none'] -%}
  {%- set _sentinel     = _ai_ent_lc in ['unknown', 'unavailable'] -%}
  {%- set _named_flynn  = _ai_ent_lc | regex_search('flynn') -%}
  {%- set _pre_flynn    = _override or _blank or _named_flynn -%}

  {#- ── Flynn reason (surfaces to gate status for diagnostics) ──────────── #}
  {%- set _flynn_reason =
        'override' if _override else
        'sentinel' if _sentinel else
        'blank_persona' if _blank else
        'explicit' if _named_flynn else
        '' -%}

  {#- ── Identity resolution (skipped in pre-Flynn cases) ──────────────── #}
  {%- if not _pre_flynn and not _sentinel -%}
    {%- set _idcard_raw   = identity_resolve_source(_ai_ent) -%}
    {%- set _idcard       = _idcard_raw | from_json if _idcard_raw is string else _idcard_raw -%}
    {%- set _idcard       = _idcard if _idcard is mapping else {} -%}
    {%- set _resolve_err  = _idcard.get('error') | default('', true) -%}
    {%- set _is_flynn     = _resolve_err != '' -%}
    {%- set _flynn_reason = _resolve_err if _is_flynn else '' -%}
  {%- else -%}
    {%- set _idcard   = {} -%}
    {%- set _is_flynn = not _sentinel -%}
  {%- endif -%}

  {#- ── Sentinel: real sensor failure — hard error, not Flynn ─────────── #}
  {%- if _sentinel -%}
render_prompt() — persona sensor unavailable (state: {{ _ai_ent }}). Check input_text.zenos_persona_name.
  {%- else -%}

    {%- set _ai_user  = (_idcard.get('identity', {}) if _idcard is mapping else {}).get('entity_id', _ai_ent) -%}
    {%- set _header   = prompt_header(_ai_user, _idcard) -%}
    {%- set _system   = prompt_system_flynn() if _is_flynn else prompt_system(_idcard) -%}
    {#- Flynn mode: skip expensive data sections — he has his own tools -#}
    {%- set _manifest  = ({} | tojson) if _is_flynn else manifest_loader() -%}
    {%- set _id_mani   = ({} | tojson) if _is_flynn else identity_manifest_loader() -%}
    {%- set _index     = ([] | tojson) if _is_flynn else root_index() -%}
    {%- set _dojo      = ({} | tojson) if _is_flynn else dojo_loader() -%}
    {%- set _active_notif = (flynn.active_notification() | trim | from_json(none)) if _is_flynn else none -%}
    {%- set _active_notif = _active_notif if (_active_notif is mapping or _active_notif is none) else none -%}
    {%- set _capsule  = ({'type': 'flynn_gate', 'reason': _flynn_reason, 'active_notification': _active_notif, 'status': flynn.flynn_gate_status(_ai_user) | trim} | tojson) if _is_flynn else ai_capsule(_idcard) -%}
    {%- set _overview = ({} | tojson) if _is_flynn else compact_overview() -%}
{"header": {{ (_header    | from_json(none) or {}) | tojson }},
"system": {{ (_system    | from_json(none) or {}) | tojson }},
"manifest": {{ (_manifest  | from_json(none) or {}) | tojson }},
"id_manifest": {{ (_id_mani  | from_json(none) or {}) | tojson }},
"index": {{ (_index     | from_json(none) or []) | tojson }},
"kata": {{ (_dojo      | from_json(none) or {}) | tojson }},
"capsule": {{ (_capsule   | from_json(none) or {}) | tojson }},
"overview": {{ (_overview  | from_json(none) or {}) | tojson }},
"session_token": "experimental_0123456789abcdef",
"boot_time": "{{ now().isoformat() }}"}
{%- if not _is_flynn %}
{{ ai_wake_sequence(_idcard) }}
{{ console_check_bridge(_idcard) }}
{{ priority_inject() }}
{{ agent_queue_inject() }}
{%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro prompt_health_check() -%}
  {%- set cab_ent = states('sensor.zen_default_ai_user_cabinet_resolved') -%}
  {%- set cab_ok  = cab_ent not in ['', 'unknown', 'unavailable', 'none'] -%}
  {%- set cv      = state_attr(cab_ent, 'variables') | default({}, true) if cab_ok else {} -%}

  {# Resolve essence via the canonical unwrapper #}
  {%- set raw_ess = cv.get('zenai_essence', {}) -%}
  {%- set ev_str  = resolve_zenai_essence(raw_ess) -%}
  {%- set ev      = ev_str | from_json if ev_str is string else {} -%}

  {# Schema detection #}
  {%- set is3    = ev.get('core') is mapping and ev.get('jacket') is mapping -%}
  {%- set schema = 'three_layer' if is3 else ('legacy' if ev | length > 0 else 'missing') -%}

  {# Jacket / core / companion fields #}
  {%- set j   = ev.get('jacket',    {}) if is3 else {} -%}
  {%- set co  = ev.get('core',      {}) if is3 else {} -%}
  {%- set cmp = ev.get('companion', {}) if is3 else {} -%}
  {%- set j_sig      = j.get('signature', '') | string -%}
  {%- set c_sig      = co.get('signature', '') | string -%}
  {%- set sig_status = 'signed' if 'md5:' in j_sig else ('pending' if j_sig == 'pending_x509' else 'unsigned') -%}
  {%- set pname      = j.get('name', ev.get('identity', {}).get('name', '')) -%}

  {# Familiar / companion #}
  {%- set fam_src     = cmp if (cmp is mapping and cmp) else ev.get('familiar', {}) -%}
  {%- set fam_name    = fam_src.get('name',    '') if fam_src is mapping else '' -%}
  {%- set fam_kfc_ref = fam_src.get('kfc_ref', '') if fam_src is mapping else '' -%}

  {# Household cabinet checks #}
  {%- set hh    = states('sensor.zen_default_household_cabinet_resolved') -%}
  {%- set hh_ok = hh not in ['', 'unknown', 'unavailable'] -%}
  {%- set hcv   = state_attr(hh, 'variables') | default({}, true) if hh_ok else {} -%}
  {%- set manifest_ok    = 'zen_library_manifest'   in hcv -%}
  {%- set id_manifest_ok = 'zen_identity_manifest'  in hcv -%}

  {# Prev snapshot present #}
  {%- set prev        = cv.get('zenai_essence_prev', {}) -%}
  {%- set prev_exists = prev is mapping and prev | length > 0 -%}

  {# Rollup state #}
  {%- set sig_ok = 'md5:' in j_sig -%}
  {# BUG FIX (2026-08-02): 'error' used to fire for ANY non-three_layer essence,
     conflating two very different things — schema == 'missing' (no essence at
     all, genuinely broken, agent has no persona) and schema == 'legacy' (a
     complete, functioning, flat-shape essence — what every real install
     checked this session actually runs on, H's own Friday persona included).
     legacy is the current universal default, not a fault; three_layer +
     signing is an optional, unmigrated, opt-in feature nobody has adopted
     anywhere yet. 'error' is now reserved for schema == 'missing' only.
     legacy is 'warn' — loads and works fine, but hasn't opted into the
     newer schema/signing capability, same non-blocking severity class as
     the other 'warn' causes below (unsigned/incomplete three_layer). #}
  {%- set state  = 'error' if schema == 'missing'
               else ('warn' if (schema == 'legacy' or not sig_ok or not manifest_ok or not id_manifest_ok)
               else 'ok') -%}

  {# Environment presence #}
  {%- set env_present = ev.get('environment') is mapping and ev.get('environment') | length > 0 -%}

  {# Wake scene char count — lightweight; full prompt measured by sensor.zen_prompt_length #}
  {%- set _wake_chars = render_wake_from_essence(ev) | trim | length -%}
  {%- set _pri_chars  = priority_inject() | trim | length -%}
  {%- set _aq_chars   = agent_queue_inject() | trim | length -%}

  {{ {
    'state':               state,
    'persona_name':        pname,
    'cabinet':             cab_ent,
    'schema':              schema,
    'signature_status':    sig_status,
    'core_hash':           c_sig,
    'jacket_hash':         j_sig,
    'signed_at':           j.get('signed_at', ''),
    'signed_by':           j.get('signed_by', ''),
    'halmark_version':     j.get('halmark_version', ''),
    'schema_version':      j.get('schema_version', ''),
    'familiar_name':       fam_name,
    'familiar_kfc_ref':    fam_kfc_ref,
    'manifest_present':    manifest_ok,
    'id_manifest_present': id_manifest_ok,
    'prev_snapshot_exists': prev_exists,
    'environment_present': env_present,
    'prompt_chars': {
      'wake_scene':      _wake_chars,
      'priority_inject': _pri_chars,
      'agent_queue':     _aq_chars
    },
    'health_signals': {
      'schema_ok':         is3,
      'sig_ok':            sig_ok,
      'manifest_ok':       manifest_ok,
      'id_manifest_ok':    id_manifest_ok,
      'familiar_ok':       fam_name != '',
      'environment_ok':    env_present
    }
  } | tojson }}
{%- endmacro -%}

