    {%- if s.entity_id == _active_eid -%}
      {%- set _entry = config_entry_id(s.entity_id) -%}
      {%- set _model = device_attr(s.entity_id, 'model_id') or device_attr(s.entity_id, 'model') -%}
      {%- set _provider = device_attr(s.entity_id, 'manufacturer') -%}
      {%- set ns.active = {
