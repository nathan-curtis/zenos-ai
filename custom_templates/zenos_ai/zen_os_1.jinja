        'integration': config_entry_attr(_entry, 'domain') if _entry else 'unspecified',
        'model': _model if _model else 'unspecified',
        'provider': _provider if _provider else 'unspecified'
      } -%}
    {%- endif -%}
  {%- endfor -%}
  {{ ns.active | tojson }}
