{#
  ZenOS-AI Shared Manifest Macro Library — zenos_manifest.jinja

  Provides: tool_manifest()

  Every DojoTool, Sutra, Root, and AdminTool calls tool_manifest() to build
  its lens_manifest / manifest response. Adding a field here propagates to
  all compliant tools automatically.

  Compliance levels:
    Level 0 — no manifest mode (tolerated, recorded as compliant: false)
    Level 1 — version + identity only (min viable)
    Level 2 — full struct (version + health + labels + lens fields)
    Level 3 — Level 2 + icon + color (UI styling hints for autotag/dashboard)

  Usage (in a script variables: step):
    {%- import 'zenos_ai/zenos_manifest.jinja' as MF -%}
    {{ MF.tool_manifest(
        tool='zen_dojotools_servicedesk',
        display_name='Service Desk / Zammad',
        tier='dojotools',
        version='0.3.1',
        health={'configured': true, 'status': 'ok', 'notes': []},
        required_labels=['service_desk'],
        optional_labels=['zammad', 'tickets', 'fulfillment'],
        consumes=['label', 'person'],
        returns=['ticket_evidence'],
        icon='mdi:ticket-outline',
        color='indigo',
        audit={'event': 'tool_manifest_read', 'severity': 'info'},
        inference={'calls_inference': true, 'ai_task_type': 'summarize',
                   'requires_capabilities': ['structured_output'],
                   'est_tokens_in': 4000, 'est_tokens_out': 400}
    ) }}
  (omit inference entirely for a non-inference tool — it now defaults to
  the false-shaped no-op automatically, see below)

  audit: opt-in only — describes an audit entry, does not persist one. The
  calling script must emit it itself (e.g. script.zen_dojotools_event_emitter),
  same pattern as essence_signed events in dojotools_profile.yaml.

  inference: ALWAYS reported (2026-08-18) — every tool_manifest() call now
  includes an inference{} block, defaulting to the false-shaped no-op below
  so non-inference tools comply automatically with zero extra work:
    {'calls_inference': false, 'ai_task_type': none, 'requires_capabilities': [],
     'est_tokens_in': 0, 'est_tokens_out': 0}
  A tool that itself invokes a model/ai_task call passes inference={...} to
  override just the keys it needs to set — combined over the defaults above,
  so a partial dict (e.g. only calls_inference + ai_task_type) is fine.
    calls_inference: true if this tool ever calls ai_task/an LLM itself.
    ai_task_type: what kind, e.g. 'summarize'/'generate'/'classify'/'extract'.
    requires_capabilities: list, e.g. ['image_understanding', 'tool_use',
      'structured_output'] — whatever the underlying ai_task call needs.
    est_tokens_in / est_tokens_out: rough estimate per typical run, for
      capacity planning. Not measured/enforced, a declared estimate only.

  missing_required_labels / missing_optional_labels: both always computed
  read-only against the live label registry (labels()) — no action required
  from callers. See zen_dojotools_manifest mode=label_audit for a system-wide
  aggregate scan with optional auto-create remediation (pass
  include_optional=true to sweep/create optional labels too, not just
  required).
#}

{%- macro tool_manifest(
    tool,
    display_name,
    tier,
    version,
    health=None,
    required_labels=None,
    optional_labels=None,
    schema_version='1.0.0',
    consumes=None,
    returns=None,
    failure_policy=None,
    content_policy=None,
    risk_class=None,
    security_act=None,
    modes=None,
    limitations=None,
    evidence_shape=None,
    children=None,
    icon=None,
    color=None,
    managed=None,
    lens_provider=None,
    stack=None,
    mcp_exposed=None,
    self_repair=None,
    preferred_state=None,
    stripe=None,
    prerequisites=None,
    impact=None,
    fallback=None,
    audit=None,
    inference=None,
    caller_token=''
) -%}
{%- set _health = health if health is mapping else {'configured': false, 'status': 'unknown', 'notes': ['health not reported']} -%}
{%- set _req = required_labels if required_labels is sequence and required_labels is not string else [] -%}
{%- set _opt = optional_labels if optional_labels is sequence and optional_labels is not string else [] -%}
{%- set _known_labels = labels() -%}
{%- set _missing_required_labels = _req | reject('in', _known_labels) | list -%}
{%- set _missing_optional_labels = _opt | reject('in', _known_labels) | list -%}
{#- OS version: canonical os_version() macro in zen_os_1.jinja, NOT the
   cabinet -- a hardcoded literal that can't go stale from a forgotten
   press step. Cortex stays cabinet-pressed (reflects which cortex TEXT
   actually loaded, a real runtime fact zen_os_1.jinja can't know on its
   own) -- see the OS VERSION note near the top of zen_os_1.jinja. -#}
{%- import 'zenos_ai/zen_os_1.jinja' as zen1 -%}
{%- set _ovd = zen1.os_version() | from_json -%}
{%- set _os_version  = _ovd.get('version', 'unknown') -%}
{%- set _os_tag      = (_ovd.get('tag', '') ~ (_ovd.get('tag_number') | string if _ovd.get('tag_number') is not none else '')) if _ovd.get('tag', '') != '' else '' -%}
{%- set _syscab = states('sensor.zen_system_cabinet_resolved') -%}
{%- set _osr_node = (state_attr(_syscab, 'variables') or {}).get('os_release', {}) -%}
{%- set _osr_str = (_osr_node.get('value', '{}') if _osr_node is mapping else (_osr_node | default('{}', true))) -%}
{%- set _osr = (_osr_str if _osr_str is mapping else (_osr_str | from_json({}))) -%}
{%- set _cortex      = _osr.get('cortex', '') -%}
{%- set _cortex_name = _osr.get('cortex_codename', '') -%}
{%- set _base = {
  'status': 'success',
  'tool': tool,
  'display_name': display_name,
  'tier': tier,
  'version': version,
  'schema_version': schema_version,
  'health': _health,
  'required_labels': _req,
  'optional_labels': _opt,
  'icon': icon if icon is string else none,
  'color': color if color is string else none,
  'os_version': _os_version,
  'os_tag': _os_tag,
  'cortex': _cortex,
  'cortex_codename': _cortex_name,
  'os_release': _osr if _osr is mapping else {},
  'missing_required_labels': _missing_required_labels,
  'missing_optional_labels': _missing_optional_labels,
  'caller_token': caller_token
} -%}
{%- if managed is not none -%}
  {%- set _base = _base | combine({'managed': managed | bool}) -%}
{%- endif -%}
{%- if lens_provider is not none -%}
  {%- set _base = _base | combine({'lens_provider': lens_provider | bool}) -%}
{%- endif -%}
{%- if stack is not none -%}
  {%- set _base = _base | combine({'stack': stack}) -%}
{%- endif -%}
{%- if mcp_exposed is not none -%}
  {%- set _base = _base | combine({'mcp_exposed': mcp_exposed | bool}) -%}
{%- endif -%}
{%- if audit is not none and audit is mapping -%}
  {%- set _base = _base | combine({'audit': audit}) -%}
{%- endif -%}
{#- 2026-08-18: inference now ALWAYS reported (was opt-in-only before) --
   Nathan: "each tool should report does it use inference... tools that
   dont have simply report false." Non-declaring tools get the full
   false-shaped default automatically; a tool that DOES use inference
   passes inference={...} to override/extend specific keys, same
   combine-over-defaults pattern the rest of this macro already uses. -#}
{%- set _inf_defaults = {
  'calls_inference': false,
  'ai_task_type': none,
  'requires_capabilities': [],
  'est_tokens_in': 0,
  'est_tokens_out': 0
} -%}
{%- set _inf = _inf_defaults | combine(inference if inference is mapping else {}) -%}
{%- set _base = _base | combine({'inference': _inf}) -%}
{%- if self_repair is not none and self_repair is sequence and self_repair is not string -%}
  {%- set _base = _base | combine({'self_repair': self_repair}) -%}
{%- endif -%}
{%- if (preferred_state is not none and preferred_state is mapping) or stripe is not none or (prerequisites is not none and prerequisites is mapping) or impact is not none or fallback is not none or _req | length > 0 or _opt | length > 0 -%}
  {%- set _ps = preferred_state if preferred_state is mapping else {} -%}
  {%- if stripe is not none -%}{%- set _ps = _ps | combine({'stripe': stripe | int}) -%}{%- endif -%}
  {%- if prerequisites is not none and prerequisites is mapping -%}{%- set _ps = _ps | combine({'prerequisites': prerequisites}) -%}{%- endif -%}
  {%- if impact is not none -%}{%- set _ps = _ps | combine({'impact': impact | string}) -%}{%- endif -%}
  {%- if fallback is not none -%}{%- set _ps = _ps | combine({'fallback': fallback | string}) -%}{%- endif -%}
  {%- if _req | length > 0 and 'required_labels' not in _ps -%}{%- set _ps = _ps | combine({'required_labels': _req}) -%}{%- endif -%}
  {%- if _opt | length > 0 and 'optional_labels' not in _ps -%}{%- set _ps = _ps | combine({'optional_labels': _opt}) -%}{%- endif -%}
  {%- set _base = _base | combine({'preferred_state': _ps}) -%}
{%- endif -%}
{%- set _lens = {} -%}
{%- if consumes is not none -%}
  {%- set _lens = _lens | combine({'consumes': consumes}) -%}
{%- endif -%}
{%- if returns is not none -%}
  {%- set _lens = _lens | combine({'returns': returns}) -%}
{%- endif -%}
{%- if failure_policy is not none -%}
  {%- set _lens = _lens | combine({'failure_policy': failure_policy}) -%}
{%- endif -%}
{%- if content_policy is not none -%}
  {%- set _lens = _lens | combine({'content_policy': content_policy}) -%}
{%- endif -%}
{%- if risk_class is not none -%}
  {%- set _lens = _lens | combine({'risk_class': risk_class}) -%}
{%- endif -%}
{%- if security_act is not none -%}
  {%- set _lens = _lens | combine({'security_act': security_act}) -%}
{%- endif -%}
{%- if modes is not none -%}
  {%- set _lens = _lens | combine({'modes': modes}) -%}
{%- endif -%}
{%- if limitations is not none -%}
  {%- set _lens = _lens | combine({'limitations': limitations}) -%}
{%- endif -%}
{%- if evidence_shape is not none -%}
  {%- set _lens = _lens | combine({'evidence_shape': evidence_shape}) -%}
{%- endif -%}
{%- if children is not none and children is sequence and children is not string -%}
  {%- set _lens = _lens | combine({'children': children}) -%}
{%- endif -%}
{{ _base | combine(_lens) | tojson }}
{%- endmacro -%}
