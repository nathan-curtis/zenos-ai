{#-
@macro: cabinet_slot_candidates
@desc: The cabinets that are member/expansion slots, in slot order. Source of
       truth is the canonical slot map (HEALTH.slot_to_default_entity, keys
       expansion_<n>), so no consumer names slot entities itself.
@returns: JSON list of entity_ids.
-#}
{%- macro cabinet_slot_candidates() -%}
  {%- import 'zenos_ai/zenos_health.jinja' as HEALTH -%}
  {%- set _map = HEALTH.slot_to_default_entity() | from_json({}) -%}
  {%- set ns = namespace(s=[]) -%}
  {%- for n in _map.keys() | select('match', '^expansion_[0-9]+$') | map('regex_replace', '^expansion_', '') | map('int') | sort -%}
    {%- set ns.s = ns.s + [_map['expansion_' ~ n]] -%}
  {%- endfor -%}
  {{- ns.s | tojson -}}
{%- endmacro -%}

{#-
@macro: cabinet_slot_status
@desc: The one free-slot rule. free = no user drawers and no cabinet_class
       stamp (an expansion slave is never free). ready = the cabinet has
       variables (booted/initialized). provision_member takes free slots,
       ready or not (the provisioner initializes them); expand_drawer and
       Room Manager setup need free AND ready.
@returns: JSON object.
-#}
{%- macro cabinet_slot_status(entity_id) -%}
  {%- set _sys = ['AI_Cabinet_VolumeInfo', 'meta', '_label_index', '_zen_relationships'] -%}
  {%- set _raw = state_attr(entity_id, 'variables') | default(none) -%}
  {%- set _vars = _raw if _raw is mapping else {} -%}
  {%- set _vi_outer = (_vars.get('AI_Cabinet_VolumeInfo') or {}) -%}
  {%- set _vi_outer = _vi_outer if _vi_outer is mapping else {} -%}
  {%- set _vi = (_vi_outer.get('value') or {}) if _vi_outer else {} -%}
  {%- set _vi = _vi if _vi is mapping else {} -%}
  {%- set _user_keys = _vars.keys() | reject('in', _sys) | list -%}
  {%- set _class = _vi.get('cabinet_class', none) -%}
  {%- set _state = states(entity_id) -%}
  {{- {
    'entity_id': entity_id,
    'state': _state,
    'ready': _raw is mapping,
    'user_drawers': _user_keys,
    'cabinet_class': _class,
    'hosted_by': _vi.get('hosted_by', none),
    'free': _state != 'unavailable' and _user_keys | length == 0 and _class is none
  } | tojson -}}
{%- endmacro -%}
